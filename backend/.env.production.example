# ==========================================
# MAZINGIRA YA PRODUCTION (SERVER)
# ==========================================

# 1. Mazingira
NODE_ENV=production
PORT=3000

# 2. Database (Weka Password ngumu sana kwenye server halisi)
DB_USER=postgres
DB_PASSWORD=WekaPasswordNgumuSanaHapa2026!
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wifi_voucher_db

# 3. Usalama (JWT)
# TENGENEZA MPYA kwa ajili ya Production kwa kutumia: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=weka_secret_ndefu_ya_random_hapa

# 4. MikroTik
# Badilisha hii iwe IP ya Router yako halisi (Mfano: 192.168.88.1) au IP ya VPN
MIKROTIK_MODE=real
MIKROTIK_HOST=192.168.88.1 
MIKROTIK_PORT=8728
MIKROTIK_USERNAME=wifi_backend
MIKROTIK_PASSWORD=Backend@2026!
MIKROTIK_HOTSPOT_NAME=hotspot1
MIKROTIK_DEFAULT_PROFILE=default
MIKROTIK_TIMEOUT=5000

# 5. App URL (Kwa ajili ya CORS na Links)
# Badilisha hii iwe domain yako halisi (Mfano: https://wifi.biashara.co.tz)
APP_URL=https://domain-yako-halisi.com